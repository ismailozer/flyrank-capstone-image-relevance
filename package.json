  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "db:migrate": "node scripts/migrate.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:seed": "node scripts/seed.js",
    "dataset:download": "node scripts/downloadDataset.js",
    "dataset:manifest": "node scripts/generateDatasetManifest.js",
    "dataset:verify": "node scripts/verifyDataset.js",
    "vision:test": "node scripts/testVision.js",
    "image:process": "node scripts/processImage.js",
    "worker:image": "node workers/imageProcessingWorker.js",
    "image:embed": "node scripts/embedImage.js",
    "eval": "node scripts/runEvaluation.js",
    "capstone:run": "docker compose up -d --wait db && npm run db:migrate && concurrently -k -n api,worker \"npm start\" \"npm run worker:image\""
  },
